rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi tasks: Setiap pengguna hanya dapat membaca, membuat, memperbarui, dan menghapus tugas milik mereka sendiri.
    match /tasks/{taskId} {
      // Izinkan baca dan hapus hanya jika pengguna sudah login dan UID sesuai dengan pemilik data
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Izinkan update hanya jika pengguna login dan UID pemilik data tidak diubah ke UID lain
      allow update: if request.auth != null && request.auth.uid == resource.data.userId && request.resource.data.userId == request.auth.uid;
      
      // Izinkan pembuatan tugas baru hanya jika pengguna login dan field userId sesuai UID mereka
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Blokir akses ke koleksi/dokumen lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
